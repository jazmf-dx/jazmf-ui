{
  "name": "@jazmf-dx/dx-ui",
  "version": "2.0.0",
  "description": "デザイントークン + Django 連携コンポーネント（Storybook = 仕様書）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jazmf-dx/jazmf-ui.git"
  },
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "gen:icons": "python3 scripts/gen-icons.py"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": "./components/dx/index.ts",
    "./islands": "./components/index.ts",
    "./styles.css": "./tokens/theme.css",
    "./tokens/*": "./tokens/*"
  },
  "files": [
    "components",
    "hooks",
    "lib",
    "tokens"
  ],
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.26.0",
    "react-day-picker": "^9.14.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
